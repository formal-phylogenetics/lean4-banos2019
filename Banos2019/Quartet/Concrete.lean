module

public import Banos2019.Quartet.Transfer
public import Banos2019.Quartet.Trees

/-!
# Computing on explicit quartet networks (Examples 2–7)

The examples of Sections 5–7 compute the concordance factors of explicit networks, given by the ends
of their edges, whose reduced networks (Lemmas 9–11) are trees.

* `indegree_eq_card_filter_target`, `outdegree_eq_card_filter_source`: degrees as sizes of finite sets.
* `indegree_eq_two_of_two_le`, `inheritance_mem_Ioo`: a hybrid node of a binary network has two hybrid
  edges, with inheritance probabilities in `(0, 1)`.
* `eq_or_of_distinct4_of_card_eq`: four distinct taxa are all the taxa.
* `quartetLeaf9`, `leafSet`: the taxa `a, b, c, d` at the nodes `0, 1, 2, 3` of an explicit network,
  and the taxa at a set of nodes.
* `reaches_iff_mem_of_desc`: the descendants of the nodes of a graph, from sets of nodes closed under
  the edges and generated by them.
* `cf_eq_of_forall_not_isHybridArc`: the concordance factors of a network without hybrid edges whose
  species tree has the split `ab|cd` (equation (1)).
-/

@[expose] public noncomputable section

open Phylogenetics Phylogenetics.RootedNetwork Finset
open scoped Classical

namespace Banos2019

variable {V E X : Type*}

/-- The number of edges entering `v`, as the size of a finite set. -/
theorem indegree_eq_card_filter_target [Fintype E] (G : DirectedMultigraph V E) (v : V) :
    G.indegree v = (univ.filter fun e => G.target e = v).card := by
  unfold DirectedMultigraph.indegree
  rw [← Set.ncard_coe_finset]
  congr 1
  ext e
  simp

/-- The number of edges leaving `v`, as the size of a finite set. -/
theorem outdegree_eq_card_filter_source [Fintype E] (G : DirectedMultigraph V E) (v : V) :
    G.outdegree v = (univ.filter fun e => G.source e = v).card := by
  unfold DirectedMultigraph.outdegree
  rw [← Set.ncard_coe_finset]
  congr 1
  ext e
  simp

/-- In a binary network, a node with two entering edges has exactly two. -/
theorem indegree_eq_two_of_two_le {N : RootedNetwork V E X} (hN : IsBinaryRootedNetwork N) {v : V}
    (hv : 2 ≤ N.graph.indegree v) : N.graph.indegree v = 2 := by
  obtain ⟨-, -, -, -, -, hr0, -, hleaf, -, hother⟩ := (isBinaryRootedNetwork_iff N).1 hN
  have hvr : v ≠ N.root := by rintro rfl; omega
  have hvl : v ∉ Set.range N.leaf := by
    rintro ⟨x, rfl⟩
    have := (hleaf x).1
    omega
  rcases hother v hvr hvl with h | h <;> omega

/-- A hybrid edge of a binary network has inheritance probability in `(0, 1)`. -/
theorem inheritance_mem_Ioo [Fintype E] {N : RootedNetwork V E X} (hN : IsBinaryRootedNetwork N)
    {θ : MetricData E} (hθ : IsMetricNetwork N θ) {h : E} (hh : N.IsHybridArc h) :
    0 < θ.inheritance h ∧ θ.inheritance h < 1 := by
  obtain ⟨⟨-, -, -, hpos, hsum⟩, -⟩ := hθ
  refine ⟨hpos h hh, ?_⟩
  have h2 := indegree_eq_two_of_two_le hN hh
  have hs := hsum _ hh
  rw [← Finset.sum_filter] at hs
  have hmem : h ∈ univ.filter fun e => N.graph.target e = N.graph.target h := by simp
  have hc : (univ.filter fun e => N.graph.target e = N.graph.target h).card = 2 := by
    rw [← h2, indegree_eq_card_filter_target]
  obtain ⟨h', hh', hne⟩ : ∃ h' ∈ univ.filter (fun e => N.graph.target e = N.graph.target h), h' ≠ h := by
    by_contra hcon
    have : (univ.filter fun e => N.graph.target e = N.graph.target h) ⊆ {h} := fun e he =>
      mem_singleton.2 (by_contra fun hne => hcon ⟨e, he, hne⟩)
    have := card_le_card this
    rw [hc, card_singleton] at this
    omega
  have hh'' : N.IsHybridArc h' := by
    unfold IsHybridArc
    rw [(mem_filter.1 hh').2]
    exact hh
  rw [← Finset.add_sum_erase _ _ hmem] at hs
  have : θ.inheritance h' ≤ ∑ e ∈ (univ.filter fun e => N.graph.target e = N.graph.target h).erase h,
      θ.inheritance e := by
    refine Finset.single_le_sum (f := θ.inheritance) (fun e he => ?_) (mem_erase.2 ⟨hne, hh'⟩)
    refine (hpos e ?_).le
    unfold IsHybridArc
    rw [(mem_filter.1 (mem_of_mem_erase he)).2]
    exact hh
  linarith [hpos h' hh'']

/-- **Reachability from descendant sets**: if every node is in its set `D u`, the sets are closed
under the edges, and every other node of `D u` is in the smaller set of a child of `u`, then `D u` is
the set of nodes that `u` reaches. -/
theorem reaches_iff_mem_of_desc {G : DirectedMultigraph V E} (D : V → Finset V)
    (hself : ∀ u, u ∈ D u) (hclosed : ∀ u e, G.source e ∈ D u → G.target e ∈ D u)
    (hgen : ∀ u, ∀ w ∈ D u, w ≠ u →
      ∃ e, G.source e = u ∧ w ∈ D (G.target e) ∧ #(D (G.target e)) < #(D u))
    (u w : V) : G.Reaches u w ↔ w ∈ D u := by
  constructor
  · intro h
    induction h with
    | refl => exact hself u
    | @tail b c _ hbc ih =>
      obtain ⟨e, rfl, rfl⟩ := hbc
      exact hclosed u e ih
  · intro hw
    induction hn : #(D u) using Nat.strong_induction_on generalizing u with
    | _ n ih =>
      by_cases hwu : w = u
      · rw [hwu]
        exact .refl
      · obtain ⟨e, hs, he, hlt⟩ := hgen u w hw hwu
        exact Relation.ReflTransGen.head ⟨e, hs, rfl⟩ (ih _ (hn ▸ hlt) _ he rfl)

variable [DecidableEq X] {a b c d : X}

/-- The leaves `a, b, c, d` at the nodes `0, 1, 2, 3` of a network on `Fin 9` nodes. -/
def quartetLeaf9 (a b c : X) (x : X) : Fin 9 :=
  if x = a then 0 else if x = b then 1 else if x = c then 2 else 3

theorem quartetLeaf9_a : quartetLeaf9 a b c a = 0 := by simp [quartetLeaf9]
theorem quartetLeaf9_b (h : Distinct4 a b c d) : quartetLeaf9 a b c b = 1 := by
  simp [quartetLeaf9, h.1.symm]
theorem quartetLeaf9_c (h : Distinct4 a b c d) : quartetLeaf9 a b c c = 2 := by
  simp [quartetLeaf9, h.2.1.symm, h.2.2.2.1.symm]
theorem quartetLeaf9_d (h : Distinct4 a b c d) : quartetLeaf9 a b c d = 3 := by
  simp [quartetLeaf9, h.2.2.1.symm, h.2.2.2.2.1.symm, h.2.2.2.2.2.symm]

/-- The leaves of `quartetLeaf9` are `0, 1, 2, 3`. -/
theorem quartetLeaf9_mem (x : X) : quartetLeaf9 a b c x ∈ ({0, 1, 2, 3} : Finset (Fin 9)) := by
  simp only [quartetLeaf9]
  split_ifs <;> decide

variable [Fintype X]

/-- Every taxon is `a`, `b`, `c` or `d`. -/
theorem eq_or_of_distinct4_of_card_eq (hX : Fintype.card X = 4) (h : Distinct4 a b c d) (x : X) :
    x = a ∨ x = b ∨ x = c ∨ x = d := by
  have huniv : ({a, b, c, d} : Finset X) = univ := eq_univ_of_card _ (by rw [h.card_insert_eq, hX])
  have : x ∈ ({a, b, c, d} : Finset X) := huniv ▸ mem_univ x
  simpa using this

/-- The taxa whose leaves are in `S`. -/
def leafSet (leaf : X → V) (S : Finset V) : Finset X := univ.filter fun x => leaf x ∈ S

omit [DecidableEq X] in
/-- Two sets of nodes have the same taxa exactly when they have the same leaves. -/
theorem leafSet_eq_leafSet_iff [DecidableEq V] {leaf : X → V} {L : Finset V} (hleaf : ∀ x, leaf x ∈ L)
    (hsurj : ∀ i ∈ L, ∃ x, leaf x = i) (S T : Finset V) :
    leafSet leaf S = leafSet leaf T ↔ S ∩ L = T ∩ L := by
  constructor
  · intro e
    ext i
    simp only [mem_inter]
    constructor
    · rintro ⟨hiS, hiL⟩
      obtain ⟨x, rfl⟩ := hsurj i hiL
      have : x ∈ leafSet leaf T := e ▸ (by simp [leafSet, hiS])
      exact ⟨by simpa [leafSet] using this, hiL⟩
    · rintro ⟨hiT, hiL⟩
      obtain ⟨x, rfl⟩ := hsurj i hiL
      have : x ∈ leafSet leaf S := e.symm ▸ (by simp [leafSet, hiT])
      exact ⟨by simpa [leafSet] using this, hiL⟩
  · intro e
    ext x
    have h₁ : leaf x ∈ S ↔ leaf x ∈ S ∩ L := by simp [hleaf x]
    have h₂ : leaf x ∈ T ↔ leaf x ∈ T ∩ L := by simp [hleaf x]
    simp only [leafSet, mem_filter, mem_univ, true_and]
    rw [h₁, h₂, e]

/-- The taxa of `quartetLeaf9` whose leaves are in `S`. -/
theorem leafSet_quartetLeaf9 (hX : Fintype.card X = 4) (h : Distinct4 a b c d) (S : Finset (Fin 9))
    (x : X) :
    x ∈ leafSet (quartetLeaf9 a b c) S ↔ (x = a ∧ 0 ∈ S) ∨ (x = b ∧ 1 ∈ S) ∨ (x = c ∧ 2 ∈ S) ∨
      (x = d ∧ 3 ∈ S) := by
  obtain ⟨hab, hac, had, hbc, hbd, hcd⟩ := id h
  simp only [leafSet, mem_filter, mem_univ, true_and]
  rcases eq_or_of_distinct4_of_card_eq hX h x with rfl | rfl | rfl | rfl
  · simp [quartetLeaf9_a, hab, hac, had]
  · simp [quartetLeaf9_b h, Ne.symm hab, hbc, hbd]
  · simp [quartetLeaf9_c h, Ne.symm hac, Ne.symm hbc, hcd]
  · simp [quartetLeaf9_d h, Ne.symm had, Ne.symm hbd, Ne.symm hcd]

omit [Fintype X] in
/-- Every leaf `0, 1, 2, 3` of `quartetLeaf9` is that of a taxon. -/
theorem quartetLeaf9_surj (h : Distinct4 a b c d) :
    ∀ i ∈ ({0, 1, 2, 3} : Finset (Fin 9)), ∃ x, quartetLeaf9 a b c x = i := by
  intro i hi
  simp only [mem_insert, mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl
  exacts [⟨a, quartetLeaf9_a⟩, ⟨b, quartetLeaf9_b h⟩, ⟨c, quartetLeaf9_c h⟩, ⟨d, quartetLeaf9_d h⟩]

variable [Fintype V] [Fintype E]

/-- **The concordance factors of a network without hybrid edges** (equation (1)): when the taxa below
a node `v` are `a, b`, or `c, d`, its species tree has the split `ab|cd`, with internal edge the chain
of the edges into the nodes with these taxa below them, of total length `L`, and the concordance factors
are `1 - ⅔e^{-L}` for `ab|cd` and `⅓e^{-L}` for `ac|bd` and `ad|bc`. -/
theorem cf_eq_of_forall_not_isHybridArc {N : RootedNetwork V E X} (hN : N.IsPhylogenetic)
    (ht : ∀ e, ¬ N.IsHybridArc e) {θ : MetricData E} (hθ : N.IsMetric θ) (hX : Fintype.card X = 4)
    (h : Distinct4 a b c d) {v : V} (hv : treeCluster N v = {a, b} ∨ treeCluster N v = {a, b}ᶜ)
    {L : ℝ} (hL : ∑ e with treeCluster N (N.graph.target e) ≠ univ ∧
      (treeCluster N (N.graph.target e) = {a, b} ∨ treeCluster N (N.graph.target e) = {a, b}ᶜ),
        θ.length e = L) :
    cf N θ (quartetTree a b c d h) = 1 - 2 / 3 * Real.exp (-L) ∧
      cf N θ (quartetTree a c b d (distinct4_acbd h)) = 1 / 3 * Real.exp (-L) ∧
      cf N θ (quartetTree a d b c (distinct4_adbc h)) = 1 / 3 * Real.exp (-L) := by
  set σ := treeSpeciesTree N hN ht hθ
  have hab : ({a, b} : Finset X) ≠ univ := fun e => by
    have := congrArg Finset.card e
    rw [card_pair h.1, card_univ, hX] at this
    omega
  have habc : ({a, b} : Finset X)ᶜ ≠ univ := fun e => by
    have : a ∈ ({a, b} : Finset X)ᶜ := e ▸ mem_univ a
    simp at this
  have hsplit : {a, b} ∈ unroot σ.clusters := by
    simp only [unroot, mem_union, mem_image, mem_erase, σ, treeSpeciesTree_clusters]
    rcases hv with hv | hv
    · exact Or.inl ⟨hab, mem_treeClusters.2 ⟨v, hv⟩⟩
    · exact Or.inr ⟨_, ⟨habc, mem_treeClusters.2 ⟨v, hv⟩⟩, compl_compl _⟩
  have hlen : σ.unrootedLength {a, b} = L := by
    rw [treeSpeciesTree_unrootedLength, hL]
  have hcf : ∀ q, cf N θ q = External.AllmanDegnanRhodes2011.quartetProb σ q := fun q =>
    nmscCF_eq_quartetProb hN ht hθ (by omega) le_rfl q
  obtain ⟨h₁, h₂⟩ := External.AllmanDegnanRhodes2011.equation1 hX σ
    (q := quartetTree a b c d h) rfl hsplit
  have m₁ : quartetTree a c b d (distinct4_acbd h) ∈ (quartetTree a b c d h).alternatives := by
    rw [QuartetTree.mem_alternatives, quartetTree_taxa_eq_insert, quartetTree_taxa_eq_insert]
    exact ⟨by ext y; simp; tauto, (quartetTree_abcd_ne_acbd h).symm⟩
  have m₂ : quartetTree a d b c (distinct4_adbc h) ∈ (quartetTree a b c d h).alternatives := by
    rw [QuartetTree.mem_alternatives, quartetTree_taxa_eq_insert, quartetTree_taxa_eq_insert]
    exact ⟨by ext y; simp; tauto, (quartetTree_abcd_ne_adbc h).symm⟩
  rw [hcf, hcf, hcf, h₁, h₂ _ m₁, h₂ _ m₂, hlen]
  exact ⟨rfl, rfl, rfl⟩

/-- **The concordance factors of a network without hybrid edges from explicit clusters**
(equation (1)): the taxa below the target of each edge `e` are those at the nodes `cl e` of an explicit
labelling `leaf'` of the taxa by the nodes `L`; the node `v` has the taxa `a, b` or `c, d` below it; and
`K` is the set of the edges into the nodes with these taxa below them, those whose `cl e` has the leaves
`S` (the taxa `a, b`) or `Sc` (the taxa `c, d`). -/
theorem cf_eq_of_treeCluster_eq_leafSet {N : RootedNetwork V E X} (hN : N.IsPhylogenetic)
    (ht : ∀ e, ¬ N.IsHybridArc e) {θ : MetricData E} (hθ : N.IsMetric θ) (hX : Fintype.card X = 4)
    (h : Distinct4 a b c d) {W : Type*} [DecidableEq W] {leaf' : X → W} {L S Sc : Finset W}
    (hleaf : ∀ x, leaf' x ∈ L) (hsurj : ∀ i ∈ L, ∃ x, leaf' x = i)
    (hS : leafSet leaf' S = {a, b}) (hSc : leafSet leaf' Sc = {a, b}ᶜ) (cl : E → Finset W)
    (hcl : ∀ e, treeCluster N (N.graph.target e) = leafSet leaf' (cl e)) {v : V}
    (hv : treeCluster N v = {a, b} ∨ treeCluster N v = {a, b}ᶜ) (K : Finset E)
    (hK : ∀ e, e ∈ K ↔ (cl e ∩ L ≠ L ∧ (cl e ∩ L = S ∩ L ∨ cl e ∩ L = Sc ∩ L))) :
    cf N θ (quartetTree a b c d h) = 1 - 2 / 3 * Real.exp (-∑ e ∈ K, θ.length e) ∧
      cf N θ (quartetTree a c b d (distinct4_acbd h)) =
        1 / 3 * Real.exp (-∑ e ∈ K, θ.length e) ∧
      cf N θ (quartetTree a d b c (distinct4_adbc h)) =
        1 / 3 * Real.exp (-∑ e ∈ K, θ.length e) := by
  have huniv : (univ : Finset X) = leafSet leaf' L := by
    ext x
    simp [leafSet, hleaf x]
  have hiff := leafSet_eq_leafSet_iff hleaf hsurj
  refine cf_eq_of_forall_not_isHybridArc hN ht hθ hX h hv ?_
  refine Finset.sum_congr (Finset.ext fun e => ?_) fun _ _ => rfl
  rw [mem_filter, hK, hcl, huniv, ← hSc, ← hS, ne_eq, hiff, hiff, hiff, inter_self]
  simp

/-- **The concordance factors of an explicit network without hybrid edges** (equation (1)), from the
descendants `D u` of its nodes: the taxa are at the nodes `L`; the node `v` has the leaves `S` (the
taxa `a, b`) or `Sc` (the taxa `c, d`) below it; and `K` is the set of the edges into the nodes with
these leaves below them, the chain of the internal edge `ab|cd`. -/
theorem cf_eq_of_desc {N : RootedNetwork V E X} [DecidableEq V] (hN : N.IsPhylogenetic)
    (ht : ∀ e, ¬ N.IsHybridArc e) {θ : MetricData E} (hθ : N.IsMetric θ) (hX : Fintype.card X = 4)
    (h : Distinct4 a b c d) (D : V → Finset V) (hD : ∀ u w, N.graph.Reaches u w ↔ w ∈ D u)
    {L S Sc : Finset V} (hleaf : ∀ x, N.leaf x ∈ L) (hsurj : ∀ i ∈ L, ∃ x, N.leaf x = i)
    (hS : leafSet N.leaf S = {a, b}) (hSc : leafSet N.leaf Sc = {a, b}ᶜ) {v : V}
    (hv : D v ∩ L = S ∩ L ∨ D v ∩ L = Sc ∩ L) (K : Finset E)
    (hK : ∀ e, e ∈ K ↔ (D (N.graph.target e) ∩ L ≠ L ∧
      (D (N.graph.target e) ∩ L = S ∩ L ∨ D (N.graph.target e) ∩ L = Sc ∩ L))) :
    cf N θ (quartetTree a b c d h) = 1 - 2 / 3 * Real.exp (-∑ e ∈ K, θ.length e) ∧
      cf N θ (quartetTree a c b d (distinct4_acbd h)) =
        1 / 3 * Real.exp (-∑ e ∈ K, θ.length e) ∧
      cf N θ (quartetTree a d b c (distinct4_adbc h)) =
        1 / 3 * Real.exp (-∑ e ∈ K, θ.length e) := by
  have hcl : ∀ u, treeCluster N u = leafSet N.leaf (D u) := fun u => by
    ext x
    simp [treeCluster, leafSet, hD]
  have hiff := leafSet_eq_leafSet_iff hleaf hsurj
  refine cf_eq_of_treeCluster_eq_leafSet hN ht hθ hX h hleaf hsurj hS hSc
    (fun e => D (N.graph.target e)) (fun e => hcl _) (v := v) ?_ K hK
  rw [hcl, ← hSc, ← hS, hiff, hiff]
  exact hv

end Banos2019
